# ─── Twitch ─────────────────────────────────────────────
# Console: https://dev.twitch.tv/console  →  Aplicativos  →  Gerenciar
TWITCH_CLIENT_ID=
# O segredo fica SÓ neste arquivo (.env). Nunca suba para o Git nem cole em chats.
TWITCH_CLIENT_SECRET=

# Precisa ser IGUAL à URL cadastrada no console da Twitch.
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# ─── Kick ───────────────────────────────────────────────
# kick.com/settings/developer → criar app (crie logado na conta do BOT, ex.: ClipeiBot)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Precisa ser IGUAL à URL de redirecionamento cadastrada no app da Kick.
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback
# A URL do webhook NÃO fica aqui: ela é cadastrada no app da Kick e precisa ser pública,
# ex.: https://SEU-DOMINIO.ngrok-free.app/api/webhooks/kick  (veja o README)

# ─── Servidor ───────────────────────────────────────────
PORT=3000
# Endereço do painel (em dev o Vite roda na 5173)
WEB_URL=http://localhost:5173
# Qualquer texto longo e aleatório — assina o cookie de login
SESSION_SECRET=troque-isto-por-um-texto-longo-e-aleatorio

# Logins da Twitch dos administradores da Clipei, separados por vírgula.
# Só eles veem o painel /app/admin e podem conectar a conta do bot.
# (Sem esta linha, em desenvolvimento qualquer conta conectada vira admin.)
ADMIN_LOGINS=

# ─── HTTPS local (opcional) ─────────────────────────────
# Só se você cadastrou https://localhost:3000/... na Twitch.
# Gere os arquivos com mkcert:  mkcert -key-file certs/key.pem -cert-file certs/cert.pem localhost
# HTTPS_KEY=certs/key.pem
# HTTPS_CERT=certs/cert.pem

# ─── Produção (servidor do jogo, ex.: Railway) ──────────
# NODE_ENV=production
# WEB_URL=https://SEU-SITE.vercel.app            (ou o domínio próprio)
# PUBLIC_WS_URL=wss://SEU-SERVIDOR.up.railway.app/ws
# TWITCH_REDIRECT_URI=https://SEU-SITE.vercel.app/api/auth/twitch/callback
#
# Supabase: Project Settings → API Keys → chave secreta (sb_secret_...).
# Sem estas duas linhas, os dados ficam em data/store.json (desenvolvimento).
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SECRET_KEY=
#
# Na Vercel (site) só existe uma variável:
# API_ORIGIN=https://SEU-SERVIDOR.up.railway.app
